# Optional. Leave empty when FastAPI serves the built client (same origin)
# or when using the Vite dev proxy. Set it only for a separately hosted frontend,
# e.g. VITE_API_URL=https://nastusha-api.onrender.com (also add the frontend origin
# to CORS_ORIGINS on the backend). Never put Supabase keys here: VITE_* values are public.
VITE_API_URL=
