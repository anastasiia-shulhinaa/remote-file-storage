# Backend configuration — SERVER-ONLY.
# Copy to backend/.env and fill in real values. Never commit backend/.env.
# Nothing in this file may be shipped to the desktop or web client.

APP_ENV=development

# Comma-separated browser origins allowed by CORS (Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL (async SQLAlchemy URL, used from TASK-005).
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase project (Auth from TASK-010, Storage from TASK-020).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_STORAGE_BUCKET=minidrive-files

MAX_UPLOAD_SIZE_MB=50
